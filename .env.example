# ScreenMe Environment Configuration
# Copy this file to .env and populate real values before running in production.
# NEVER commit .env files or real secrets.

# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/screenme

# Authentication (use a strong 32+ character secret in production)
JWT_SECRET=replace-with-a-cryptographically-random-32-char-secret
COOKIE_SECURE=false

# AI Provider (server-side only, never exposed to client)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2

# Upload & Rate Limits
MAX_UPLOAD_SIZE_BYTES=5242880
GUEST_REPORT_TTL_HOURS=24
ANALYSIS_RATE_LIMIT_PER_HOUR=15

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:4000/api/v1

